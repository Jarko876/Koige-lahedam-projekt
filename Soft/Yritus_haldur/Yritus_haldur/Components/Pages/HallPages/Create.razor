@page "/halls/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IHallsRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage Entity="item" EntityTitle="Hall" BasePath="/halls"
OnValidSubmit="add" />

@code {
    [SupplyParameterFromForm(Name = nameof(Hall))] private Hall item { get; set; } = default!;
    protected override void OnInitialized() => item ??= new();
    private async Task add() {
        await repo.CreateAsync(item);
        NavigationManager.NavigateTo("/halls");
    }
}
