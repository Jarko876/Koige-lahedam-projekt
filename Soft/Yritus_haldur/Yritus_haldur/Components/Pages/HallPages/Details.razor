@page "/halls/details"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IHallsRepo repo
@inject NavigationManager NavigationManager

<MyDetailsPage PageTitleText="Details hall" Entity="item" EntityTitle="Hall"
               EntityId="item?.Id" BasePath="/halls" />

@code {
    private Hall item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync() {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
}
