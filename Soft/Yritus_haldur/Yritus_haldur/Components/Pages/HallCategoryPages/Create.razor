@page "/hallcategories/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IHallCategoriesRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage Entity="item" EntityTitle="Hall category" BasePath="/hallcategories" 
OnValidSubmit="add" />

@code {
    [SupplyParameterFromForm(Name = nameof(HallCategory))] private HallCategory item { get; set; } = default!;
    protected override void OnInitialized() => item ??= new();
    private async Task add() {
        await repo.CreateAsync(item);
        NavigationManager.NavigateTo("/hallcategories");
    }
}
