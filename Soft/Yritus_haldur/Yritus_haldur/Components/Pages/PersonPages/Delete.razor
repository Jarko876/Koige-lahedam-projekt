@page "/persons/delete"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IPersonsRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage PageTitleText="Delete person" EntityTitle="Person"
              Entity="item" BasePath="/persons" OnValidSubmit="delete" />

@code {
    private Person item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }

    private async Task delete()
    {
        await repo.DeleteAsync(Id);
        NavigationManager.NavigateTo("/persons");
    }
}
