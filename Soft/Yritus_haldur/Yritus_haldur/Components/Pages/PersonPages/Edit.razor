@page "/persons/edit"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IPersonsRepo repo
@inject NavigationManager NavigationManager

<MyEditPage PageTitleText="Edit person" EntityTitle="@item?.Email" Entity="item"
            EntityId="@Id" BasePath="/persons" OnValidSubmit="update" />

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(Name = nameof(Person))] private Person item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        item ??= await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }

    private async Task update()
    {
        await repo.UpdateAsync(item!);
        NavigationManager.NavigateTo("/persons");
    }
}
