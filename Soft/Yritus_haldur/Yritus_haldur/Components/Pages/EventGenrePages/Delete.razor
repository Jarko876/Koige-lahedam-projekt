@page "/eventgenres/delete"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IEventGenresRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage PageTitleText="Delete EventGenre" EntityTitle="EventGenre" 
    Entity="item" BasePath="/eventgenres" OnValidSubmit="delete" />    
@code {
    private EventGenre item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync() {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete() {
        await repo.DeleteAsync(Id);
        NavigationManager.NavigateTo("/eventgenres");
    }
}
