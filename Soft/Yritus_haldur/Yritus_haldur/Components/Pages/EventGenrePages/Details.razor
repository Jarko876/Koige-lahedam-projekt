@page "/eventgenres/details"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IEventGenresRepo repo
@inject NavigationManager NavigationManager

<MyDetailsPage PageTitleText="Details Event Genre" Entity="item" EntityTitle="Event Genre"
               EntityId="item?.Id" BasePath="/eventgenres" />
@code {
    private EventGenre item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync() {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
}
