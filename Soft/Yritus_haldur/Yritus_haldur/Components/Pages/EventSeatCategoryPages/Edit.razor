@page "/eventSeatCategories/edit"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject NavigationManager NavigationManager
@inject IEventSeatCategoriesRepo repo

<MyEditPage 
    PageTitleText="Edit Event Seat Category"
            EntityTitle="@item?.Name"
            Entity="item"
            BasePath="/eventSeatCategories"
            EntityId="@Id"
            OnValidSubmit="update" />


@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(Name = nameof(EventSeatCategory))] private EventSeatCategory item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (repo is null) return;

        item ??= await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task update()
    {
        if (item is null) return;

        await repo.UpdateAsync(item!);

        NavigationManager.NavigateTo("/eventSeatCategories");
    }
}
