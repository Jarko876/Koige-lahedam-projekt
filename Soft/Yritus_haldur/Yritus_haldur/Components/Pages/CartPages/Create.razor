@page "/carts/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject NavigationManager NavigationManager
@inject ICartsRepo repo


<MyCreatePage Entity="item" EntityTitle="Cart" BasePath="/carts" OnValidSubmit="add" />

@code {
    [SupplyParameterFromForm(Name = nameof(Cart))] private Cart item { get; set; } = default!;
    protected override void OnInitialized() => item ??= new();
    private async Task add() {
        await repo.CreateAsync(item);
        NavigationManager.NavigateTo("/payments");
    }
}
