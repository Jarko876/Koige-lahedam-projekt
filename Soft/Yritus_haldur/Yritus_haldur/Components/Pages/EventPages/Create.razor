@page "/events/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IEventsRepo repo
@inject NavigationManager NavigationManager

<MyCreatePage Entity="item" EntityTitle="Event" BasePath="/events" 
OnValidSubmit="add" />

@code {
    [SupplyParameterFromForm(Name = nameof(Event))] private Event item { get; set; } = default!;
    protected override void OnInitialized() => item ??= new();
    private async Task add() {
        await repo.CreateAsync(item);
        NavigationManager.NavigateTo("/events");
    }
}
