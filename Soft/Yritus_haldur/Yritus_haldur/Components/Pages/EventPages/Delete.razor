@page "/events/delete"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IEventsRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage PageTitleText="Delete Event" EntityTitle="Event" 
    Entity="item" BasePath="/events" OnValidSubmit="delete" />

@code {
    private Event item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync() {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete() {
        await repo.DeleteAsync(Id);
        NavigationManager.NavigateTo("/events");
    }
}
