@page "/payments/create"
@page "/payments/create/{cartId}"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject NavigationManager NavigationManager
@inject IPaymentsRepo paymentRepo

<MyEntitiesSelect @bind-Value="item.CartId"
                  EntityType="typeof(Cart)"
                  DisplayProperty="Name" />

<MyCreatePage Entity="item" 
             EntityTitle="Payment" 
             BasePath="/payments" 
             OnValidSubmit="add" />

@code {
    [Parameter]
    public string? CartId { get; set; }

    [SupplyParameterFromForm(Name = nameof(Payment))]
    private Payment item { get; set; } = default!;


    protected override void OnInitialized()
    {
        item ??= new() { PaymentDate = DateTime.Now };

        if (!string.IsNullOrEmpty(CartId) && Guid.TryParse(CartId, out var cartId))
        {
            item.CartId = cartId;
        }
    }

    private async Task add()
    {
        await paymentRepo.CreateAsync(item);
        NavigationManager.NavigateTo("/payments");
    }
}
