@page "/payments/details"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Infra
@using Abc.Shared.Pages
@using Microsoft.EntityFrameworkCore
@using Abc.Data
@inject IPaymentsRepo repo
@inject NavigationManager NavigationManager

<MyDetailsPage PageTitleText="Details Payment"
               EntityTitle="Payment"
               Entity="item"
               EntityId="item?.Id"
               BasePath="/payments" />

@if (item?.Cart != null)
{
    <div class="mt-4">
        <h5>Related Cart</h5>
        <div class="card">
            <div class="card-body">
                <p><strong>Cart Name:</strong> @item.Cart.Name</p>
                <p><strong>Cart ID:</strong> @item.Cart.Id</p>
                <p><strong>Created:</strong> @item.Cart.CreatedAt.ToString("g")</p>
                <a href="/carts/details?id=@item.Cart.Id" class="btn btn-info btn-sm">View Cart Details</a>
            </div>
        </div>
    </div>
}

@code {
    private Payment item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NotFound();
        }
    }
}