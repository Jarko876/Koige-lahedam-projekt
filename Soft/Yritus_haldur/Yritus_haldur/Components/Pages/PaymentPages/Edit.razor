@page "/payments/edit"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject NavigationManager NavigationManager
@inject IPaymentsRepo repo

<MyEditPage 
    PageTitleText="Edit Payment"
            EntityTitle="@item?.Name"
            Entity="item"
            BasePath="/payments"
            EntityId="@Id"
            OnValidSubmit="update" />


@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm(Name = nameof(Payment))] private Payment item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (repo is null) return;

        item ??= await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task update()
    {
        if (item is null) return;

        await repo.UpdateAsync(item);

        NavigationManager.NavigateTo("/payments");
    }
}
