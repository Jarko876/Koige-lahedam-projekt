@page "/seatcategories/delete"
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager NavigationManager
@inject ISeatCategoriesRepo repo
@using Abc.Data
@using Abc.Infra;
@using Abc.Shared.Pages

<MyDeletePage PageTitleText="Delete Seat Category"
              EntityTitle="Seat Category"
              Entity="item"
              BasePath="/seatcategories"
              OnValidSubmit="delete" />
@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    private SeatCategory item { get; set; }
    protected override async Task OnInitializedAsync() {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete() {
        
            await repo.DeleteAsync(item.Id);
            NavigationManager.NavigateTo("/seatcategories");
        
    }
}
