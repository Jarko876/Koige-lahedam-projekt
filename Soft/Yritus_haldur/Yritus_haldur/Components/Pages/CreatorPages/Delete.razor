@page "/creators/delete"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject NavigationManager NavigationManager
@inject ICreatorsRepo repo

<MyDeletePage PageTitleText="Delete Creator"
              EntityTitle="Creator"
              Entity="item"
              BasePath="/creators"
              OnValidSubmit="delete" />

@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    private Creator item { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        item ??= await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    
    private async Task delete()
    {
        await repo.DeleteAsync(item.Id);
        NavigationManager.NavigateTo("/creators");
    }
}
