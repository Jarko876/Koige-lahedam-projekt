@page "/seats/delete"
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager NavigationManager
@inject ISeatsRepo repo
@using Abc.Data
@using Abc.Infra;
@using Abc.Shared.Pages

<MyDeletePage PageTitleText="Delete Seat"
              EntityTitle="Seat"
              Entity="item"
              BasePath="/seats"
              OnValidSubmit="delete" />
@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    private Seat item { get; set; }

    protected override async Task OnInitializedAsync() {
        item ??= await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }
    private async Task delete() {
        await repo.DeleteAsync(item.Id);
        NavigationManager.NavigateTo("/seats");
    }
}
