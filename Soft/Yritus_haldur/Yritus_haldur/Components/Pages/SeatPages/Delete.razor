@page "/seats/delete"
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager NavigationManager
@inject ISeatsRepo repo
@using Abc.Data
@using Abc.Infra;
@using Abc.Shared.Components

<MyDeletePage PageTitleText="Delete Seat"
              EntityTitle="Seat"
              Entity="seat"
              EntityId="seat?.Id"
              BasePath="/seats"
              OnValidSubmit="DeleteSeat" />
@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    private Seat? seat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        seat ??= await repo.GetAsync(Id);
        if (seat is null) NavigationManager.NotFound();
    }

    private async Task DeleteSeat()
    {
        if (seat is null) return;

        await repo.DeleteAsync(seat.Id);
        NavigationManager.NavigateTo("/seats");
    }
    
}
