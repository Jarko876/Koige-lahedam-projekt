@page "/seats/delete"
@using Microsoft.EntityFrameworkCore
@using Abc.Data
@inject IDbContextFactory<Abc.Soft.Yritus_haldur.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Seat</h2>
    <hr />
    @if (seat is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Number</dt>
            <dd class="col-sm-10">@seat.Number</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Row</dt>
            <dd class="col-sm-10">@seat.Row</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">HallId</dt>
            <dd class="col-sm-10">@seat.HallId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SeatCategoryId</dt>
            <dd class="col-sm-10">@seat.SeatCategoryId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@seat.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Timestamp</dt>
            <dd class="col-sm-10">@seat.Timestamp</dd>
        </dl>
        <EditForm method="post" Model="seat" OnValidSubmit="DeleteSeat" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(seat is null)">Delete</button> |
            <a href="/seats">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Seat? seat;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        seat = await context.Seats.FirstOrDefaultAsync(m => m.Id == Id);

        if (seat is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteSeat()
    {
        using var context = DbFactory.CreateDbContext();
        context.Seats.Remove(seat!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/seats");
    }
}
