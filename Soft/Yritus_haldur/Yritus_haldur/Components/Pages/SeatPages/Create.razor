@page "/seats/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Components
@inject NavigationManager NavigationManager
@inject ISeatsRepo repo


<MyCreatePage Entity="seat" EntityTitle="Seat" BasePath="/seats" OnValidSubmit="AddSeat" />

@code {
    [SupplyParameterFromForm] private Seat seat { get; set; } = default!;
    protected override void OnInitialized() => seat ??= new();
    private async Task AddSeat()
    {
        await repo.CreateAsync(seat);
        NavigationManager.NavigateTo("/seats");
    }
}
