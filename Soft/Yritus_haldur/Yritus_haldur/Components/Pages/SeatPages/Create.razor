@page "/seats/create"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject NavigationManager NavigationManager
@inject ISeatsRepo repo


<MyCreatePage Entity="item" EntityTitle="Seat" BasePath="/seats" OnValidSubmit="add" />

@code {
    [SupplyParameterFromForm(Name = nameof(Seat))] private Seat item { get; set; } = default!;
    protected override void OnInitialized() => item ??= new();
    private async Task add() {
        await repo.CreateAsync(item);
        NavigationManager.NavigateTo("/seats");
    }
}
