@page "/seats/details"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Infra
@using Microsoft.EntityFrameworkCore
@using Abc.Data
@inject ISeatsRepo repo
@inject IDbContextFactory<Abc.Infra.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<MyDetailsPage PageTitleText="Details Seats"
               EntityTitle="Seat"
               Entity="seat"
               EntityId="seat?.Id"
               BasePath="/seats" />

@code {
    private Seat seat;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        seat = await repo.GetAsync(Id);

        if (seat is null)
        {
            NavigationManager.NotFound();
        }
    }
}
