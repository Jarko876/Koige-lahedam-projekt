@page "/seats/details"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Infra
@using Abc.Shared.Pages
@using Microsoft.EntityFrameworkCore
@using Abc.Data
@inject ISeatsRepo repo
@inject NavigationManager NavigationManager

<MyDetailsPage PageTitleText="Details Seats"
               EntityTitle="Seat"
               Entity="item"
               EntityId="item?.Id"
               BasePath="/seats" />

@code {
    private Seat item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync() {
        item = await repo.GetAsync(Id);

        if (item is null)
        {
            NavigationManager.NotFound();
        }
    }
}
