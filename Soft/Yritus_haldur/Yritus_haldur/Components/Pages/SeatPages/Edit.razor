@page "/seats/edit"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Components
@inject NavigationManager NavigationManager
@inject ISeatsRepo repo

<MyEditPage 
    PageTitleText="Edit Seat"
            EntityTitle="@Seat?.Name"
            Entity="Seat"
            BasePath="/seats"
            EntityId="@Id"
            OnValidSubmit="UpdateSeat" />


@code {
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    [SupplyParameterFromForm] private Seat? Seat { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (repo is null) return;

        Seat ??= await repo.GetAsync(Id);

        if (Seat is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateSeat()
    {
        if (Seat is null) return;

        await repo.UpdateAsync(Seat);

        NavigationManager.NavigateTo("/seats");
    }
}
