@page "/userroles/delete"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data
@using Abc.Infra
@using Abc.Shared.Pages
@inject IUserRolesRepo repo
@inject NavigationManager NavigationManager

<MyDeletePage PageTitleText="Delete user role" EntityTitle="User role"
              Entity="item" BasePath="/userroles" OnValidSubmit="delete" />

@code {
    private UserRole item;
    [SupplyParameterFromQuery] private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        item = await repo.GetAsync(Id);
        if (item is null) NavigationManager.NotFound();
    }

    private async Task delete()
    {
        await repo.DeleteAsync(Id);
        NavigationManager.NavigateTo("/userroles");
    }
}
